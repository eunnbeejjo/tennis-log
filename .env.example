# Supabase (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 기상청 공공데이터포털 - 단기예보 조회서비스 인증키
KMA_API_KEY=

# 관측지점 번호 (예: 수원 119, 서울 108). 비워두면 기본값(119) 사용
WEATHER_STATION_ID=

# PIN 잠금용 해시값. 아래 명령으로 생성해서 넣으세요:
#   node -e "console.log(require('crypto').createHash('sha256').update('원하는4자리PIN').digest('hex'))"
APP_PIN_HASH=

# 위 커맨드로 나온 랜덤 문자열을 세션 서명용으로 사용 (아무 긴 문자열이나 가능)
SESSION_SECRET=
